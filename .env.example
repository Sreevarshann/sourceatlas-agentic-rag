# Copy to backend/.env. The default database password is for the local compose stack only.
SOURCEATLAS_DATABASE_URL=postgresql+psycopg://sourceatlas:sourceatlas_local_only@127.0.0.1:55502/sourceatlas
SOURCEATLAS_DATA_DIR=./var
SOURCEATLAS_LLM_PROVIDER=ollama          # ollama | openai_compatible | fixture
SOURCEATLAS_LLM_BASE_URL=http://127.0.0.1:11434
SOURCEATLAS_LLM_MODEL=qwen3:4b-instruct
SOURCEATLAS_EMBEDDING_PROVIDER=ollama    # ollama | hashing (deterministic, CI)
SOURCEATLAS_EMBEDDING_MODEL=nomic-embed-text
# SOURCEATLAS_SEARXNG_URL=http://127.0.0.1:8888   # optional web research
